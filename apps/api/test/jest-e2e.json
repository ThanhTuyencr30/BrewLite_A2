{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "esnext",
          "target": "es2022"
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\./.*)\\.js$": "$1",
    "^@nestjs/common$": "<rootDir>/../../node_modules/@nestjs/common"
  }
}