@startuml
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

title BrewLite – Class Diagram (Sơ đồ Lớp Kiến trúc Hệ thống)

note "Code-aligned model: persisted entities follow backend/prisma/schema.prisma.\nAmounts use Int VND. Cart/CartItem are frontend state, not database models.\nBusiness operations are implemented mainly in NestJS services/scheduler rather than as Prisma model methods." as NoteArchitecture #FFF7ED

note "Customer / Barista chỉ là tác nhân (actor) trong Use Case, không phải model kế thừa User trong schema.\nPayment là một model duy nhất, phân biệt bằng method (WALLET, CARD, QR, VNPAY)." as NoteActors #FFF7ED

' =========================
' 1. PERSISTED ENTITIES (PRISMA MODELS)
' =========================
package "Database Entities (Prisma Models)" #EAF2F8 {

    class User {
        + id: String (UUID)
        + email: String (unique)
        + passwordHash: String
        + fullName: String?
        + phone: String? (unique)
        + loyaltyPoints: Int
    }

    class PasswordResetToken {
        + id: String (UUID)
        + userId: String (unique)
        + tokenHash: String (unique)
        + expiresAt: DateTime
        + createdAt: DateTime
    }

    class Promotion {
        + id: Int
        + code: String (unique)
        + discountType: DiscountType
        + value: Int (VND)
        + minOrderValue: Int
        + maxDiscount: Int?
        + startsAt: DateTime
        + endsAt: DateTime
        + usageLimit: Int?
        + usedCount: Int
    }

    class UserPromotion {
        + userId: String (PK)
        + promotionId: Int (PK)
        + claimedAt: DateTime
        + usedAt: DateTime?
    }

    class Category {
        + id: Int
        + name: String (unique)
        + slug: String (unique)
        + sortOrder: Int
        + isActive: Boolean
    }

    class Product {
        + id: Int
        + categoryId: Int
        + name: String
        + slug: String
        + description: String?
        + basePrice: Int (VND)
        + stock: Int
        + version: Int
        + isAvailable: Boolean
        + imageUrl: String
    }

    class ProductSize {
        + id: Int
        + productId: Int
        + size: SizeCode
        + additionalPrice: Int
        --
        + unique: productId + size
    }

    class Ingredient {
        + id: Int
        + name: String (unique)
        + unit: String
        + stock: Int
    }

    class ProductIngredient {
        + productId: Int (PK)
        + size: SizeCode (PK)
        + ingredientId: Int (PK)
        + quantity: Int
    }

    class Topping {
        + id: Int
        + name: String
        + slug: String
        + price: Int
        + stock: Int
        + version: Int
        + isAvailable: Boolean
    }

    class ProductTopping {
        + productId: Int (PK)
        + toppingId: Int (PK)
    }

    class Order {
        + id: String (UUID)
        + code: String (unique)
        + userId: String
        + promotionId: Int?
        + status: OrderStatus
        + subtotal: Int
        + discount: Int
        + total: Int
        + expiresAt: DateTime?
        + version: Int
        + cancelledAt: DateTime?
        + cancelReason: String?
        + createdAt: DateTime
        + updatedAt: DateTime
    }

    class OrderItem {
        + id: Int
        + productId: Int
        + orderId: String (UUID)
        + productName: String
        + size: SizeCode
        + iceLevel: IceLevel
        + quantity: Int
        + unitPrice: Int
        + lineTotal: Int
    }

    class OrderItemTopping {
        + orderItemId: Int (PK)
        + toppingId: Int (PK)
        + toppingName: String
        + unitPrice: Int
    }

    class OrderStatusHistory {
        + id: Int
        + orderId: String (UUID)
        + fromStatus: OrderStatus?
        + toStatus: OrderStatus
        + note: String?
        + changedAt: DateTime
    }

    class Payment {
        + id: String (UUID)
        + orderId: String (UUID)
        + idempotencyKey: String (unique)
        + method: PaymentMethod
        + status: PaymentStatus
        + amount: Int (VND)
        + providerTransactionId: String?
        + failureReason: String?
        + createdAt: DateTime
        + updatedAt: DateTime
    }
}

' =========================
' 2. FRONTEND CLIENT STATE
' =========================
package "Frontend State (Client-Side)" #EAF2F8 {
    class Cart <<frontend>> {
        + items: CartItem[]
        --
        Client-side context/local state
        No PostgreSQL model
    }

    class CartItem <<frontend>> {
        + productId: number
        + size: SizeCode
        + iceLevel: IceLevel
        + toppings: number[]
        + quantity: number
        + unitPrice: number
        --
        Stored in browser cart state
    }
}

' =========================
' 3. ENUMS
' =========================
package "Enumerations" #F3E8FF {
    enum SizeCode {
        S
        M
        L
    }

    enum IceLevel {
        NONE
        LESS
        NORMAL
        EXTRA
    }

    enum DiscountType {
        PERCENT
        FIXED_AMOUNT
    }

    enum OrderStatus {
        PENDING
        PAID
        PREPARING
        READY
        COMPLETED
        PAYMENT_FAILED
        CANCELLED
    }

    enum PaymentMethod {
        WALLET
        CARD
        QR
        VNPAY
    }

    enum PaymentStatus {
        PENDING
        SUCCEEDED
        FAILED
        REFUNDED
    }
}

' =========================
' 4. SERVICES / CONTROLLERS / SCHEDULER
' =========================
package "Lớp xử lý Nghiệp vụ (NestJS Backend Services)" #E8F5E9 {
    class AuthService <<service>> {
        + register(email, password, fullName?, phone?)
        + login(email, password): accessToken
        + me(userId): User [GET /auth/me]
    }

    class CartService <<service>> {
        + validateCart(items)
        --
        kiểm tra giá hiện tại và tồn kho sản phẩm
    }

    class PromotionsController <<controller>> {
        + findAvailable(): GET /promotions/me (public)
    }

    class OrdersService <<service>> {
        + createOrder(userId, items, discountCode?)
        + getMyOrders(userId): GET /orders/me
        + getOrderDetail(id, userId): GET /orders/:id
        + cancelOrder(id, userId): POST /orders/:id/cancel
        --
        tính promotion; trừ / hoàn kho trong transaction
    }

    class OrderStateMachine <<service>> {
        + assertTransition(currentStatus, nextStatus)
        --
        Đối chiếu validTransitions
        Ném BadRequestException nếu không hợp lệ
    }

    class PaymentsService <<service>> {
        + create(userId, dto): POST /payments
        + confirmQr(paymentId): POST /payments/:id/confirm
        + handleVnpayCallback(query): xác minh chữ ký/số tiền
        --
        cộng điểm vào User.loyaltyPoints khi SUCCEEDED
    }

    class OrdersScheduler <<scheduler>> {
        + cancelExpiredPendingOrders(): @Cron mỗi phút
        --
        hủy đơn PENDING quá hạn
        không xử lý đơn PAYMENT_FAILED
        hoàn tồn kho và lượt dùng mã giảm giá
    }
}

' =========================
' ENTITY RELATIONSHIPS
' =========================
User "1" -- "0..1" PasswordResetToken : reset token >
User "1" -- "0..*" Order : places >
User "1" -- "0..*" UserPromotion : claims >

Promotion "1" -- "0..*" UserPromotion : claimed by >
Promotion "0..1" -- "0..*" Order : applied to >

Category "1" -- "0..*" Product : contains >
Product "1" -- "0..*" ProductSize : sizes >
Product "1" -- "0..*" ProductIngredient : recipe rows >
Ingredient "1" -- "0..*" ProductIngredient : used by >

Product "1" -- "0..*" ProductTopping : allowed >
Topping "1" -- "0..*" ProductTopping : linked products >

Order "1" *-- "0..*" OrderItem : contains >
Product "1" -- "0..*" OrderItem : referenced by >

OrderItem "1" -- "0..*" OrderItemTopping : toppings >
Topping "1" -- "0..*" OrderItemTopping : referenced by >

Order "1" -- "0..*" OrderStatusHistory : history >
Order "1" -- "0..*" Payment : payments >

Cart "1" *-- "0..*" CartItem : contains >
Product "1" -- "0..*" CartItem : cart line uses >

' =========================
' SERVICE DEPENDENCIES (DASHED)
' =========================
AuthService ..> User : dùng
PromotionsController ..> Promotion : đọc dữ liệu
CartService ..> Product : kiểm tra tồn kho & giá
OrdersService ..> Order : khởi tạo & quản lý
OrderStateMachine ..> OrderStatusHistory : kiểm soát chuyển vết
PaymentsService ..> Payment : xử lý giao dịch
OrdersScheduler ..> Order : quét đơn PENDING hết hạn

@enduml