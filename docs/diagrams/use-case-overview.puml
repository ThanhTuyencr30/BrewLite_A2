@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Times New Roman"

actor "Khách hàng" as Customer
actor "Cổng thanh toán giả lập (mock)\nVí / Thẻ / QR" as MockGateway
actor "Cổng VNPay\n(hệ thống ngoài)" as VNPay
actor "Scheduler" as Scheduler

rectangle "Hệ thống BrewLite (Next.js + NestJS + PostgreSQL)" {
  package "Menu & Sản phẩm" {
    usecase "UC-01 Xem menu đồ uống" as UC01
    usecase "UC-02 Xem chi tiết sản phẩm" as UC02
    usecase "UC-03 Thêm vào giỏ hàng" as UC03
    usecase "UC-04 Chọn kích cỡ (Size)" as UC04
    usecase "UC-05 Chọn topping" as UC05
    usecase "UC-06 Chọn lượng đá" as UC06
  }

  package "Giỏ hàng" {
    usecase "UC-07 Xem giỏ hàng & tổng tiền" as UC07
    usecase "UC-08 Sửa số lượng sản phẩm" as UC08
    usecase "UC-09 Xóa sản phẩm /\nlàm trống giỏ" as UC09
  }

  package "Tài khoản" {
    usecase "UC-10 Đăng ký tài khoản" as UC10
    usecase "UC-11 Xem tài khoản\n& điểm thưởng" as UC11
    usecase "UC-12 Xem danh sách khuyến mãi" as UC12
    usecase "UC-13 Đăng xuất" as UC13
    usecase "UC-14 Đăng nhập (JWT)" as UC14
  }

  package "Đặt hàng & Thanh toán" {
    usecase "UC-15 Đặt hàng (tạo đơn PENDING)" as UC15
    usecase "UC-16 Áp mã giảm giá" as UC16
    usecase "UC-17 Kiểm tra tồn kho" as UC17
    usecase "UC-18 Thanh toán không tiền mặt" as UC18
    usecase "UC-19 Chọn phương thức\nthanh toán" as UC19
    usecase "UC-20 Ví điện tử" as UC20
    usecase "UC-21 Thẻ ngân hàng" as UC21
    usecase "UC-22 Chuyển khoản QR" as UC22
    usecase "UC-32 Thanh toán VNPay" as UC32
    usecase "UC-23 Xử lý thanh toán (idempotent)" as UC23
    usecase "UC-24 Cộng điểm thưởng" as UC24
    usecase "UC-25 Thanh toán lại /\nĐổi phương thức" as UC25
  }

  package "Theo dõi đơn hàng" {
    usecase "UC-26 Xem xác nhận đơn hàng" as UC26
    usecase "UC-27 Xem lịch sử đơn hàng" as UC27
    usecase "UC-28 Theo dõi trạng thái đơn" as UC28
    usecase "UC-29 Hủy đơn hàng" as UC29
    usecase "UC-30 Đặt lại đơn hàng" as UC30
    usecase "UC-31 Tự động hủy đơn\nPENDING quá hạn" as UC31
  }
}

' Liên kết Khách hàng
Customer -- UC01
Customer -- UC02
Customer -- UC03
Customer -- UC07
Customer -- UC08
Customer -- UC09
Customer -- UC10
Customer -- UC11
Customer -- UC12
Customer -- UC13
Customer -- UC14
Customer -- UC15
Customer -- UC18
Customer -- UC26
Customer -- UC27
Customer -- UC28

' Quan hệ Include / Extend
UC03 ..> UC04 : <<include>>
UC05 ..> UC03 : <<extend>>
UC06 ..> UC03 : <<extend>>

UC16 ..> UC15 : <<extend>>
UC15 ..> UC17 : <<include>>

UC18 ..> UC19 : <<include>>
UC18 ..> UC23 : <<include>>
UC24 ..> UC18 : <<extend>>
UC25 ..> UC18 : <<extend>>

UC29 ..> UC28 : <<extend>>
UC30 ..> UC28 : <<extend>>

' Generalization phương thức thanh toán
UC20 --|> UC19
UC21 --|> UC19
UC22 --|> UC19
UC32 --|> UC19

' Liên kết các hệ thống ngoài
UC23 -- MockGateway
UC32 -- VNPay
UC31 -- Scheduler
@enduml