@startuml
left to right direction
skinparam packageStyle rectangle

title BrewLite – Phần rã Use Case: Đặt hàng & Thanh toán

' =========================
' Actors
' =========================
actor "Khách hàng" as Customer
actor "Cổng VNPAY\n(hệ thống ngoài)" as VNPAY
actor "Cổng thanh toán giả lập (mock)\nVí / Thẻ / QR" as MockPayment

' =========================
' System Boundary & Use Cases
' =========================
rectangle "BrewLite – Phần rã Use Case: Đặt hàng & Thanh toán" {

    usecase "UC-15 Đặt hàng (tạo đơn\nPENDING)" as UC15
    usecase "UC-16 Áp mã giảm giá" as UC16
    usecase "UC-17 Kiểm tra tồn kho" as UC17

    usecase "UC-18 Thanh toán không\ntiền mặt" as UC18
    usecase "UC-19 Chọn phương thức\nthanh toán" as UC19

    usecase "UC-20 Ví điện tử" as UC20
    usecase "UC-21 Thẻ ngân hàng" as UC21
    usecase "UC-22 Chuyển khoản QR" as UC22

    usecase "UC-23 Xử lý thanh toán\n(idempotent)" as UC23
    usecase "UC-24 Cộng điểm thưởng" as UC24
    usecase "UC-25 Thanh toán lại / đổi\nphương thức" as UC25

    usecase "UC-34 Thanh toán VNPAY" as UC34
}

' =========================
' Actor Associations
' =========================
Customer --> UC15
Customer --> UC18
Customer --> UC25

VNPAY --> UC34
MockPayment --> UC23

' =========================
' Include Relationships
' =========================
UC15 ..> UC17 : <<include>>
UC18 ..> UC19 : <<include>>
UC23 ..> UC25 : <<include>>

' =========================
' Extend Relationships
' =========================
UC16 ..> UC15 : <<extend>>
UC24 ..> UC15 : <<extend>>\n[khi thanh toán thành công]
UC25 ..> UC23 : <<extend>>\n[khi thanh toán thất bại]

' =========================
' Generalization Relationships
' =========================
UC20 --|> UC19
UC21 --|> UC19
UC22 --|> UC19

UC34 --|> UC18

@enduml