@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Times New Roman"

actor "Khách hàng" as Customer

rectangle "Phân hệ Tài khoản & Khuyến mãi" {
  usecase "UC-10 Đăng ký tài khoản" as UC10
  usecase "UC-11 Xem tài khoản\n& điểm thưởng" as UC11
  usecase "UC-12 Xem danh sách khuyến mãi" as UC12
  usecase "UC-13 Đăng xuất" as UC13
  usecase "UC-14 Đăng nhập (JWT)" as UC14
}

Customer -- UC10
Customer -- UC11
Customer -- UC12
Customer -- UC13
Customer -- UC14
@enduml