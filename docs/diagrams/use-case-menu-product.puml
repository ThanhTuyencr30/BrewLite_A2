@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Times New Roman"

actor "Khách hàng" as Customer

rectangle "Phân hệ Menu & Sản phẩm" {
  usecase "UC-01 Xem menu đồ uống" as UC01
  usecase "UC-02 Xem chi tiết sản phẩm" as UC02
  usecase "UC-03 Thêm vào giỏ hàng" as UC03
  usecase "UC-04 Chọn kích cỡ (Size)" as UC04
  usecase "UC-05 Chọn topping" as UC05
  usecase "UC-06 Chọn lượng đá" as UC06
}

Customer -- UC01
Customer -- UC02
Customer -- UC03

UC03 ..> UC04 : <<include>>
UC05 ..> UC03 : <<extend>>
UC06 ..> UC03 : <<extend>>
@enduml